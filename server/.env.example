NODE_ENV=production
# Render provides PORT automatically. Do not hard-code it in production.
# Leave false/empty in production; only use true if local DNS resolution needs a public resolver.
FORCE_PUBLIC_DNS=false
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# Exact public Vercel origin, e.g. https://devnotes.vercel.app
CLIENT_ORIGIN=https://devnotes.vercel.app
# Password reset links should open the same public frontend.
RESET_PASSWORD_ORIGIN=https://devnotes.vercel.app
COOKIE_NAME=devnotes_token
# Vercel proxies /api to Render, so browser requests are same-origin.
COOKIE_SAMESITE=lax

# Password reset email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-devnotes-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=DevNotes <your-devnotes-email@gmail.com>
